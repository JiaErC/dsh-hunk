{
  "name": "dsh-hunk",
  "version": "0.3.0",
  "private": true,
  "description": "在 DSH 自带的右侧栏里增加一个「Hunk 评审」tab：把当前会话 cwd 下 live Hunk 会话的文件 / hunk / 注释列出来（只读）。",
  "repository": {
    "type": "git",
    "url": "git@gitee.com:JiaErC/dsh-hunk.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "preview": "node scripts/preview.mjs",
    "watch": "node build.mjs --watch"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@shikijs/langs": "^4.5.0",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "shiki": "^4.5.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
